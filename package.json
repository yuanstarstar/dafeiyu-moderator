{
  "name": "@local/dafeiyu-moderator",
  "version": "0.1.9",
  "private": true,
  "description": "大肥鱼 AI 房管：同时看直播弹幕和直播画面，像真人一样陪聊、接梗、谢礼物，能 @ 观众提醒，屡教不改才禁言。",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "python",
    "vendor",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "插件介绍.md"
  ]
}
